{
  "entities": {
    "ContactSubmission": {
      "title": "ContactSubmission",
      "description": "Formulaire de contact envoyé depuis le site Blade Runner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "VoightKampffSession": {
      "title": "VoightKampffSession",
      "description": "Session d'un test de Voight-Kampff par un utilisateur",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "answers": { "type": "array" },
        "verdict": { "type": "string" },
        "analysis": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["answers", "verdict", "analysis", "createdAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Art conceptuel éditable de Syd Mead",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "medium": { "type": "string" },
        "artist": { "type": "string" },
        "date": { "type": "string" },
        "catalogId": { "type": "string" },
        "description": { "type": "string" },
        "technicalSpec": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "title", "category", "medium", "artist", "date", "catalogId", "description", "technicalSpec", "imageUrl"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Spécifications d'un véhicule éditables",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "lore": { "type": "string" },
        "visualUrl": { "type": "string" },
        "specs": { "type": "object" }
      },
      "required": ["id", "name", "category", "description", "lore", "visualUrl", "specs"]
    },
    "Discussion": {
      "title": "Discussion",
      "description": "Une discussion ouverte sur l'univers de Blade Runner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "title", "content", "createdAt"]
    },
    "Rating": {
      "title": "Rating",
      "description": "Une note de 1 à 5 étoiles sur un élément",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetId": { "type": "string" },
        "targetType": { "type": "string" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetId", "targetType", "rating", "createdAt"]
    },
    "Actor": {
      "title": "Actor",
      "description": "Fiche de personnage et acteur de Blade Runner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "character": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["Humain", "Réplicant", "Inconnu"] },
        "description": { "type": "string" },
        "secretInfo": { "type": "string" },
        "portraitUrl": { "type": "string" },
        "archivalRepresentation": { "type": "string" },
        "keyQuote": { "type": "string" },
        "coordinates": { "type": "object" }
      },
      "required": ["id", "name", "character", "role", "status", "description", "secretInfo", "portraitUrl", "archivalRepresentation", "keyQuote", "coordinates"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Un commentaire laissé par un utilisateur sur l'une des pages principales",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pageId": { "type": "string" },
        "author": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "pageId", "author", "content", "createdAt"]
    }
  },
  "firestore": {
    "contact_submissions/{submissionId}": {
      "schema": "ContactSubmission",
      "description": "Stocke les soumissions de contact"
    },
    "vk_sessions/{sessionId}": {
      "schema": "VoightKampffSession",
      "description": "Stocke les résultats de test de Voight-Kampff"
    },
    "gallery_items/{itemId}": {
      "schema": "GalleryItem",
      "description": "Art de la galerie de photos"
    },
    "vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Spécifications de véhicules"
    },
    "news_discussions/{discussionId}": {
      "schema": "Discussion",
      "description": "Les discussions publiques de l'Hôtel Bradbury"
    },
    "ratings/{ratingId}": {
      "schema": "Rating",
      "description": "Les notations de personnages ou versions"
    },
    "actors/{actorId}": {
      "schema": "Actor",
      "description": "Fiches des acteurs et personnages"
    },
    "page_comments/{commentId}": {
      "schema": "Comment",
      "description": "Les commentaires pour chaque page principale (Le film, Versions, Livre)"
    }
  }
}
